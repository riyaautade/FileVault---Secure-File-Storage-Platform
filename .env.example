# FileVault Docker Environment Configuration
# Copy this file to .env and modify the values as needed

# Database Configuration
DB_NAME=filevault
DB_USER=filevault
DB_PASSWORD=filevault123
DB_PORT=5432

# Backend Configuration
BACKEND_PORT=8080
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-please
RATE_LIMIT=100
STORAGE_QUOTA=104857600

# Frontend Configuration
FRONTEND_PORT=3000

# React App Environment Variables
REACT_APP_API_URL=http://localhost:8080
REACT_APP_GRAPHQL_URL=http://localhost:8080/graphql

# Development Settings
NODE_ENV=production
ENVIRONMENT=production

# Security Settings (for production)
# JWT_SECRET=generate-a-strong-random-key-for-production
# DB_PASSWORD=use-a-strong-password-for-production